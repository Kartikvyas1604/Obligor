# ============================================
# Obligor — environment configuration
# Copy to .env.local and adjust per environment.
# All values have safe development defaults; the config loader
# (lib/env.ts) validates and warns about dangerous production combos.
# ============================================

# --- Runtime ---
# NODE_ENV is set by the platform; DATA_DIR/L,LOG_LEVEL are optional.
# DATA_DIR=.data
# LOG_LEVEL=info

# --- Demo escape hatches (default OFF in production) ---
# Serve demo record books on /api/v1/demo/* endpoints
# DEMO_ALLOW_FIXTURES=true
# Allow unpaid clearing calls (dev only; skips x402 402 challenge)
# DEMO_ALLOW_UNPAID=true
# Accept UNVERIFIED x402 receipt headers (dev only; fail-closed in prod).
# Without this, any claimed x-payment-signature is rejected in production.
# X402_ACCEPT_UNVERIFIED_SIGNATURES=true

# --- Session store ---
# memory: fast, in-process, lost on restart (dev)
# file: durable JSON store under DATA_DIR (single-instance prod)
# sqlite: node:sqlite DB file under DATA_DIR — safe for multiple processes on a
#         shared volume (scale-out without an external service). Node 22.3+.
# SESSION_STORE_MODE=file
# SESSION_TTL_MS=86400000
# SQLITE_PATH=/data/obligor.db
# Idempotency replay/conflict store; defaults to the session-store mode
# (sqlite when SESSION_STORE_MODE=sqlite, else memory).
# IDEMPOTENCY_BACKEND=sqlite

# --- Rate limiting (per IP, in-memory; put a gateway in front for multi-instance) ---
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_COMPUTE_MAX=30
# RATE_LIMIT_DEMO_MAX=10

# --- x402 payments (V2, exact scheme) ---
# X402_PRICE_USD=0.01
# X402_BASE_UNITS=10000
# Solana devnet defaults below; override per environment.
# X402_NETWORK_SOLANA=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# X402_ASSET_MINT_SOLANA=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Monad testnet defaults below.
# X402_NETWORK_MONAD=eip155:10143
# X402_ASSET_MINT_MONAD=0x534b2f3A21130d7a60830c2Df862319e593943A3
# Destination wallets. Empty = payments disabled for that chain (health reflects it).
# SOLANA_PAY_TO=
# MONAD_PAY_TO=
# Monad x402 is gated: set X402_MONAD_ENABLED=true ONLY after running
# `npm run verify:x402` and confirming the Monad facilitator probe passes.
# MONAD_PAY_TO alone never enables Monad payments (stronger than MONAD_PAY_TO).
# X402_MONAD_ENABLED=false
# Facilitator URLs, only advertised when set. Re-verify live before wiring.
# FACILITATOR_URL_SOLANA=
# FACILITATOR_URL_MONAD=https://x402-facilitator.molandak.org

# --- Position ingestion limits & haircut table ---
# POSITION_HAIRCUT_SPOT=0.10
# POSITION_HAIRCUT_PERP=0.15
# POSITION_HAIRCUT_EQUITY=0.25
# POSITION_MAX_LEGS_PER_BOOK=16
# POSITION_MAX_NOTIONAL_PER_LEG=50000000

# --- Oracle reliability ---
# Warn when marks are older than this (fallback marks are labeled honestly)
# ORACLE_STALENESS_MS=300000
# Keep serving last-known marks instead of failing the whole session
# ORACLE_FALLBACK_ENABLED=true

# --- Confidential backends (trust transports) ---
# false (default): backends run the formula locally as sealed-execution
#   simulation and label it simulated_plaintext_compute.
# true: the real transport URL below is REQUIRED — an unconfigured wire fails
#   closed instead of silently falling back to plaintext simulation.
# CONFIDENTIAL_REAL_TRANSPORTS=false
# Real enclave HTTP wire (enclave/obligor-enclave). `hardware_attested_tee` is
#   claimed ONLY when the enclave returns a verified hardware quote; an
#   un-attested enclave process reports simulated_plaintext_compute with a note.
# ENCLAVE_ENDPOINT=http://127.0.0.1:5000
# Real Arcium MXE transport (requires @arcium-hq/client lifecycle wiring).
# ARCIUM_MXE_ENDPOINT=

# --- Drift venue adapter (J1) ---
# Mainnet Drift user authority (base58 subaccount owner) to verify desk drift
# exposure against. UNSET (default) = desk exposure reported as
# desk-declared/unverified on compute responses — never fabricated.
# DRIFT_AUTHORITY=
# DRIFT_SUBACCOUNT_ID=0
# Official Drift Data API (self-hostable); envelope is schema-validated and
# any unreachable/unparseable state fails loudly on compute responses.
# DRIFT_DATA_API_BASE=https://data.api.drift.trade
# DRIFT_SUBACCOUNT_CACHE_MS=30000
